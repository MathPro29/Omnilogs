# ==============================================================================
# ตัวอย่างไฟล์ตั้งค่าสภาพแวดล้อม (Environment Configuration) สำหรับ Omnilogs
# คัดลอกไฟล์นี้ไปยัง '.env' สำหรับใช้ปรับแต่งใน Local หรือ Deployment บน Cloud
# ระบุค่าจริงตามสภาพแวดล้อมของคุณ (Development / Staging / Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# การตั้งค่าสภาพแวดล้อมแอปพลิเคชันและเครือข่าย (App Environment & Network)
# ------------------------------------------------------------------------------
# APP_ENV: เลือกใช้ 'development', 'staging', หรือ 'production'
APP_ENV=production
APP_PORT=2910
API_PORT=2910

# CORS: รายการ Origin ที่อนุญาต คั่นด้วยเครื่องหมายจุลภาค (Comma)
# สำหรับบน Cloud/Production ให้ใส่ Domain ของ Frontend เช่น https://omnilogs.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.yourdomain.com,http://localhost:5173

# พอร์ตจำลองสำหรับ Docker Compose ในเครื่อง Local
POSTGRES_HOST_PORT=5499
ELASTICSEARCH_HOST_PORT=9200
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# ------------------------------------------------------------------------------
# การตั้งค่าฐานข้อมูล (PostgreSQL Database)
# ------------------------------------------------------------------------------
# กำหนด DB_HOST ไปยัง Cloud Database เช่น AWS RDS, GCP Cloud SQL, Supabase หรือชื่อ Container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnilogs
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# การตั้งค่า Database Connection Pool (ปรับตาม Memory และขนาด Cloud Instance)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_IDLE_TIME_SECONDS=300
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_SLOW_QUERY_THRESHOLD_MS=500

# ------------------------------------------------------------------------------
# ความปลอดภัยและการยืนยันตัวตน (Security, JWT & Encryption)
# ------------------------------------------------------------------------------
# การจำกัดเวลาคำขอ API Timeout
API_REQUEST_TIMEOUT_SECONDS=15
API_SLOW_REQUEST_THRESHOLD_MS=2000

# ข้อควรระวังด้านความปลอดภัยสูง (CRITICAL SECURITY):
# JWT_SECRET: บน Production ควรใช้ Secret Key แบบสุ่มที่ยาวและปลอดภัย (เช่น สุ่มผ่านคำสั่ง `openssl rand -base64 32`)
JWT_SECRET=your-random-32-character-secret-key-change-in-prod

# DATA_ENCRYPTION_KEY: ต้องมีความยาว "ตรง 32 ตัวอักษรพอดี" (32 bytes) สำหรับการเข้ารหัส AES-256
DATA_ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456

# ระยะเวลาหมดอายุของ Token (หน่วยเป็นวินาที)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# หน้าเอกสาร Swagger (แนะนำตั้งเป็น 'false' บน Production เพื่อความปลอดภัย)
SWAGGER_ENABLED=false

# ------------------------------------------------------------------------------
# การจำกัดอัตราการส่งคำขอ (Rate Limiting & Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

UPLOAD_RATE_LIMIT_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# ระบบค้นหาและวิเคราะห์ข้อมูล (Elasticsearch)
# ------------------------------------------------------------------------------
# URL สำหรับเชื่อมต่อ Elasticsearch (Elastic Cloud, AWS OpenSearch หรือ Self-hosted Cluster)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_QUERY_TIMEOUT_SECONDS=10
ELASTICSEARCH_SLOW_QUERY_THRESHOLD_MS=1000

# การตั้งค่า Snapshot / สำรองข้อมูล Elasticsearch
ELASTICSEARCH_SNAPSHOT_ENABLED=false
ELASTICSEARCH_SNAPSHOT_REPOSITORY=omnilogs-archive
ELASTICSEARCH_SNAPSHOT_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# พื้นที่จัดเก็บไฟล์คลาวด์ (Cloudflare R2 / AWS S3 Compatible Storage)
# ------------------------------------------------------------------------------
# รูปแบบ R2 Endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=omnilogs-archives
R2_OBJECT_PREFIX=backups

# ------------------------------------------------------------------------------
# ระบบ Retention และ Background Worker
# ------------------------------------------------------------------------------
RETENTION_WORKER_POLL_SECONDS=30
RETENTION_WORKER_LEAD_SECONDS=30

# ------------------------------------------------------------------------------
# คิวข้อความ (NATS JetStream Message Queue)
# ------------------------------------------------------------------------------
# URL เชื่อมต่อ NATS (เช่น nats://localhost:4222 หรือ nats://user:password@nats-cloud.example.com:4222)
NATS_URL=nats://localhost:4222
NATS_STREAM=OMNILOGS_LOGS
NATS_SUBJECT=omnilogs.logs.ingest
NATS_CONSUMER=omnilogs-worker

# การปรับแต่ง Batching & Backpressure
NATS_FETCH_BATCH_SIZE=100
NATS_FETCH_MAX_WAIT_MS=250
NATS_MAX_ACK_PENDING=200

# ------------------------------------------------------------------------------
# การควบคุมการเข้าถึง (Access Control)
# ------------------------------------------------------------------------------
# รายการ User ID ที่อนุญาตให้เข้าถึง คั่นด้วยเครื่องหมายจุลภาค (เว้นว่างไว้หากไม่ต้องการจำกัดสิทธิ์)
ALLOWED_USER_IDS=


