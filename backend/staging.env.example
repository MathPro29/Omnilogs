# Staging Environment Configuration
# Copy to a secret-managed .env.staging file; never commit populated values.

# Application & Service Ports
APP_ENV=staging
APP_PORT=2910
API_PORT=2910
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=https://logs-staging.example.com

# Container Host Port Overrides (Docker Compose)
POSTGRES_HOST_PORT=5499
ELASTICSEARCH_HOST_PORT=9200
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnilogs
DB_USERNAME=omnilogs
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_IDLE_TIME_SECONDS=300
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_SLOW_QUERY_THRESHOLD_MS=500

# API & Security
API_REQUEST_TIMEOUT_SECONDS=15
API_SLOW_REQUEST_THRESHOLD_MS=2000

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
# Must be exactly 32 bytes. Replace this marker before startup.
DATA_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTES!!!
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800
SWAGGER_ENABLED=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_QUERY_TIMEOUT_SECONDS=10
ELASTICSEARCH_SLOW_QUERY_THRESHOLD_MS=1000
# Snapshot repository must be registered in Elasticsearch first.
ELASTICSEARCH_SNAPSHOT_ENABLED=false
ELASTICSEARCH_SNAPSHOT_REPOSITORY=omnilogs-archive
ELASTICSEARCH_SNAPSHOT_TIMEOUT_SECONDS=1800

# Cloudflare R2 archive storage (S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omnilogs-archives
R2_OBJECT_PREFIX=backups
RETENTION_WORKER_POLL_SECONDS=30
RETENTION_WORKER_LEAD_SECONDS=30

# NATS Message Queue
NATS_URL=nats://localhost:4222
NATS_STREAM=OMNILOGS_LOGS
NATS_SUBJECT=omnilogs.logs.ingest
NATS_CONSUMER=omnilogs-worker
# A smaller processing round prevents one busy product from holding the worker
# for too long. NATS_MAX_ACK_PENDING bounds memory and downstream pressure.
NATS_FETCH_BATCH_SIZE=100
NATS_FETCH_MAX_WAIT_MS=250
NATS_MAX_ACK_PENDING=200

# Access Control
ALLOWED_USER_IDS=
